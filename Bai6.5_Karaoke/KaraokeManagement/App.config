<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Nếu dùng SQL Express, đổi Data Source=. thành Data Source=.\SQLEXPRESS -->
    <add name="DB" connectionString="Data Source=.;Initial Catalog=KaraokeDB;Integrated Security=True;TrustServerCertificate=True" />
  </connectionStrings>
</configuration>
